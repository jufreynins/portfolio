# Legacy URL redirects (carried over from the old Astro site's astro.config.mjs)
Redirect 301 /services/website-wordpress /services

# 2026-08 redesign: Portfolio -> Work, Personal Projects -> Systems (nav simplified to
# Work / Systems / About / Tools / Contact). /systems previously redirected to
# /personal-projects — it's now a real route, so that rule is gone.
Redirect 301 /portfolio /work
Redirect 301 /personal-projects /systems
Redirect 301 /lab /systems
Redirect 301 /services/custom-web-apps /systems

# Image to WebP Converter was renamed/expanded into Image Format Converter (bidirectional JPG/PNG/WebP)
Redirect 301 /tools/image-to-webp /tools/image-toolkit

# Image Format Converter, Image Compressor, Image Resizer & Cropper, and Social Media Image Resizer
# were consolidated into a single tabbed Image Toolkit workspace
Redirect 301 /tools/image-format-converter /tools/image-toolkit
Redirect 301 /tools/image-compressor /tools/image-toolkit
Redirect 301 /tools/image-resizer /tools/image-toolkit
Redirect 301 /tools/social-media-image-resizer /tools/image-toolkit

DirectoryIndex index.html
ErrorDocument 404 /404.html
