---
interface Props {
  /** Monospace route label shown in the mock browser chrome, e.g. "/dashboard/inventory" */
  routeLabel: string;
  /** Index (0-3) of the active sidebar item. */
  activeNav?: number;
}

const { routeLabel, activeNav = 0 } = Astro.props;
const navItems = [0, 1, 2, 3];
const rows = [0, 1, 2];
---

<div
  class="system-preview relative overflow-hidden rounded-xl border"
  style="border-color: var(--border-color); background: var(--surface-white);"
  aria-hidden="true"
>
  <div class="flex items-center gap-1.5 border-b px-3 py-2" style="border-color: var(--border-color); background: var(--brand-soft);">
    <span class="h-2 w-2 rounded-full" style="background: var(--border-color);"></span>
    <span class="h-2 w-2 rounded-full" style="background: var(--border-color);"></span>
    <span class="h-2 w-2 rounded-full" style="background: var(--border-color);"></span>
    <span class="ml-2 truncate font-mono text-[10px]" style="color: var(--text-secondary);">{routeLabel}</span>
  </div>

  <div class="flex">
    <div class="hidden w-10 flex-col gap-2 border-r p-2 sm:flex" style="border-color: var(--border-color);">
      {navItems.map((i) => (
        <span
          class="h-2 w-full rounded-full"
          style={`background: ${i === activeNav ? 'var(--brand-primary)' : 'var(--border-color)'};`}
        ></span>
      ))}
    </div>

    <div class="flex flex-1 flex-col gap-2 p-3">
      <div class="grid grid-cols-3 gap-1.5">
        <span class="h-7 rounded-lg" style="background: var(--brand-lavender);"></span>
        <span class="h-7 rounded-lg" style="background: var(--brand-soft);"></span>
        <span class="h-7 rounded-lg" style="background: var(--brand-soft);"></span>
      </div>
      <div class="flex flex-col gap-1.5">
        {rows.map((i) => (
          <span class="flex items-center gap-2 rounded-md px-2 py-1.5" style="background: var(--surface-warm);">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full" style="background: var(--brand-primary);"></span>
            <span class="h-1.5 rounded-full" style={`width: ${62 - i * 12}%; background: var(--border-color);`}></span>
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
