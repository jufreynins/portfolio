---
import { siteConfig } from '../config/site';
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  /** Set when the page's first section has a dark background, so header text stays legible before scrolling. */
  dark?: boolean;
}

const { dark = false } = Astro.props;

const currentPath = Astro.url.pathname;

function isNavActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header data-header-variant={dark ? 'dark' : 'light'}>
  <div class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 glass" data-header-bg></div>
  <div class="absolute bottom-0 left-0 h-px bg-white/0 transition-[width] duration-150 ease-out" data-scroll-progress style="background: var(--color-accent); width: 0%;"></div>

  <Container class="flex items-center justify-between py-4 transition-[padding] duration-300" data-header-inner>
    <a href="/" class="site-logo-link flex items-center gap-2.5 text-xl font-serif tracking-tight text-zinc-900" aria-label={`${siteConfig.name} — Home`}>
      <span class="flex h-9 w-9 items-center justify-center rounded-full border border-black/10 font-mono text-xs font-medium" style="background: var(--brand-lavender); color: var(--brand-primary);">
        {siteConfig.initials}
      </span>
      <span class="hidden sm:inline">{siteConfig.name}</span>
    </a>

    <nav class="hidden 2xl:flex items-center gap-5" aria-label="Primary">
      {siteConfig.nav.map((item) => {
        const children = 'children' in item ? item.children : undefined;

        if (children && children.length > 0) {
          const groupActive = isNavActive(item.href) || children.some((child) => isNavActive(child.href.split('#')[0]));
          const panelId = `dropdown-${item.label.toLowerCase().replace(/\s+/g, '-')}`;
          return (
            <div class="relative" data-dropdown>
              <button
                type="button"
                class:list={['nav-link relative flex items-center gap-1.5 text-sm font-medium text-zinc-900/70 transition-colors hover:text-zinc-900 py-1', { 'is-active': groupActive }]}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={panelId}
                data-dropdown-toggle
              >
                {item.label}
                <svg data-dropdown-chevron xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron transition-transform duration-200"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div
                id={panelId}
                role="menu"
                aria-label={item.label}
                class="dropdown-panel absolute left-0 top-full mt-2 w-72 rounded-2xl border p-2"
                style="border-color: var(--border-color); background: var(--surface-white); box-shadow: var(--shadow-md);"
                data-dropdown-panel
              >
                {children.map((child) => (
                  <a
                    role="menuitem"
                    href={child.href}
                    class="block rounded-xl px-4 py-2.5 text-sm font-medium text-zinc-900/80 transition-colors hover:bg-black/5 hover:text-zinc-900"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={item.href}
            class:list={['nav-link relative text-sm font-medium text-zinc-900/70 transition-colors hover:text-zinc-900 py-1', { 'is-active': isNavActive(item.href) }]}
            aria-current={isNavActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden 2xl:flex items-center gap-3">
      <Button href={siteConfig.cvPath} variant="secondary" target="_blank" rel="noopener noreferrer">
        Download CV
      </Button>
      <Button href="/contact" variant="primary">Start a Project</Button>
    </div>

    <button
      type="button"
      class="header-mobile-toggle 2xl:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-black/10 text-zinc-900"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
      data-menu-toggle
    >
      <svg data-icon-open xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg data-icon-close class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </Container>

  <div id="mobile-menu" class="2xl:hidden hidden glass mx-4 mb-4 rounded-2xl px-6 py-6" data-mobile-menu>
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {siteConfig.nav.map((item) => {
        const children = 'children' in item ? item.children : undefined;

        if (children && children.length > 0) {
          const groupActive = isNavActive(item.href) || children.some((child) => isNavActive(child.href.split('#')[0]));
          return (
            <div class="flex flex-col" data-mobile-dropdown>
              <button
                type="button"
                class:list={['flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium hover:bg-black/5', groupActive ? 'text-zinc-900 bg-black/5' : 'text-zinc-900/85 hover:text-zinc-900']}
                aria-expanded="false"
                data-mobile-dropdown-toggle
              >
                {item.label}
                <svg data-mobile-dropdown-chevron xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron transition-transform duration-200"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="hidden flex-col gap-0.5 py-1 pl-3" data-mobile-dropdown-panel>
                {children.map((child) => (
                  <a
                    href={child.href}
                    class="rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-900/70 hover:bg-black/5 hover:text-zinc-900"
                    data-mobile-link
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={item.href}
            class:list={['rounded-lg px-3 py-3 text-base font-medium hover:bg-black/5', isNavActive(item.href) ? 'text-zinc-900 bg-black/5' : 'text-zinc-900/85 hover:text-zinc-900']}
            aria-current={isNavActive(item.href) ? 'page' : undefined}
            data-mobile-link
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="mt-4 flex flex-col gap-3 border-t border-black/10 pt-4">
      <Button href={siteConfig.cvPath} variant="secondary" class="w-full" target="_blank" rel="noopener noreferrer">
        Download CV
      </Button>
      <Button href="/contact" variant="primary" class="w-full">Start a Project</Button>
    </div>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 0;
    background: var(--color-accent);
    transition: width 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.is-active::after {
    width: 100%;
  }
  .nav-link.is-active {
    color: #18181b;
  }

  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .dropdown-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-chevron.is-open {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel {
      transition: opacity 0.01ms;
    }
  }

  /* Before the user scrolls, a page whose first section is dark needs light header text for contrast. */
  [data-header-variant='dark']:not(.is-scrolled) .nav-link,
  [data-header-variant='dark']:not(.is-scrolled) .site-logo-link,
  [data-header-variant='dark']:not(.is-scrolled) .header-mobile-toggle {
    color: rgba(255, 255, 255, 0.85);
  }
  [data-header-variant='dark']:not(.is-scrolled) .nav-link:hover,
  [data-header-variant='dark']:not(.is-scrolled) .nav-link.is-active {
    color: #fff;
  }
  [data-header-variant='dark']:not(.is-scrolled) .header-mobile-toggle {
    border-color: rgba(255, 255, 255, 0.25);
  }
</style>

<script>
  let controller: AbortController | null = null;

  function initHeader() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>('[data-header]');
    const headerBg = document.querySelector<HTMLElement>('[data-header-bg]');
    const headerInner = document.querySelector<HTMLElement>('[data-header-inner]');
    const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const iconOpen = toggle?.querySelector('[data-icon-open]');
    const iconClose = toggle?.querySelector('[data-icon-close]');
    const mobileLinks = menu?.querySelectorAll<HTMLElement>('a') ?? [];

    if (!header) return;

    const closeMenu = () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.classList.remove('no-scroll');

      menu?.querySelectorAll<HTMLElement>('[data-mobile-dropdown-panel]').forEach((panel) => {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
      });
      menu?.querySelectorAll<HTMLElement>('[data-mobile-dropdown-toggle]').forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
      menu?.querySelectorAll<HTMLElement>('[data-mobile-dropdown-chevron]').forEach((chevron) => chevron.classList.remove('is-open'));
    };

    toggle?.addEventListener(
      'click',
      () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeMenu();
        } else {
          menu?.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          iconOpen?.classList.add('hidden');
          iconClose?.classList.remove('hidden');
          document.body.classList.add('no-scroll');
        }
      },
      { signal }
    );

    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    // --- Desktop "Solutions" dropdown ---
    const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

    const closeDropdown = (dropdown: HTMLElement) => {
      dropdown.querySelector('[data-dropdown-panel]')?.classList.remove('is-open');
      dropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      dropdown.querySelector('[data-dropdown-chevron]')?.classList.remove('is-open');
    };

    const closeAllDropdowns = () => dropdowns.forEach(closeDropdown);

    dropdowns.forEach((dropdown) => {
      const dropdownToggle = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
      const panel = dropdown.querySelector<HTMLElement>('[data-dropdown-panel]');
      const chevron = dropdown.querySelector<HTMLElement>('[data-dropdown-chevron]');
      if (!dropdownToggle || !panel) return;

      let closeTimer: ReturnType<typeof setTimeout> | null = null;

      const openDropdown = () => {
        if (closeTimer) clearTimeout(closeTimer);
        panel.classList.add('is-open');
        dropdownToggle.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('is-open');
      };

      const scheduleClose = () => {
        closeTimer = setTimeout(() => closeDropdown(dropdown), 150);
      };

      // Click always opens rather than toggling: on mouse it arrives after "mouseenter"
      // already opened the panel, so a toggle would immediately re-close it. Touch devices
      // (no hover) rely on this to open; a second tap outside the panel closes it.
      dropdownToggle.addEventListener('click', openDropdown, { signal });

      dropdown.addEventListener('mouseenter', openDropdown, { signal });
      dropdown.addEventListener('mouseleave', scheduleClose, { signal });
      dropdown.addEventListener('focusin', openDropdown, { signal });
      dropdown.addEventListener(
        'focusout',
        (e) => {
          const next = (e as FocusEvent).relatedTarget as Node | null;
          if (!next || !dropdown.contains(next)) closeDropdown(dropdown);
        },
        { signal }
      );

      panel.addEventListener(
        'click',
        (e) => {
          if ((e.target as HTMLElement).closest('a')) closeDropdown(dropdown);
        },
        { signal }
      );
    });

    document.addEventListener(
      'click',
      (e) => {
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(e.target as Node)) closeDropdown(dropdown);
        });
      },
      { signal }
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') closeAllDropdowns();
      },
      { signal }
    );

    // --- Mobile "Solutions" accordion ---
    document.querySelectorAll<HTMLElement>('[data-mobile-dropdown]').forEach((dropdown) => {
      const accordionToggle = dropdown.querySelector<HTMLButtonElement>('[data-mobile-dropdown-toggle]');
      const panel = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-panel]');
      const chevron = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-chevron]');
      if (!accordionToggle || !panel) return;

      accordionToggle.addEventListener(
        'click',
        () => {
          const isOpen = accordionToggle.getAttribute('aria-expanded') === 'true';
          accordionToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          panel.classList.toggle('hidden', isOpen);
          panel.classList.toggle('flex', !isOpen);
          chevron?.classList.toggle('is-open', !isOpen);
        },
        { signal }
      );
    });

    const onScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;

      if (progress) progress.style.width = `${pct}%`;
      if (headerBg) headerBg.style.opacity = scrollY > 24 ? '1' : '0';
      if (headerInner) headerInner.classList.toggle('py-2.5', scrollY > 24);
      if (headerInner) headerInner.classList.toggle('py-4', scrollY <= 24);
      header.classList.toggle('is-scrolled', scrollY > 24);
    };

    window.addEventListener('scroll', onScroll, { signal, passive: true });
    onScroll();

    document.addEventListener(
      'astro:before-preparation',
      () => {
        closeMenu();
        closeAllDropdowns();
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
