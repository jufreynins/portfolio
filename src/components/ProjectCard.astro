---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
---

<article class="project-card reveal flex flex-col overflow-hidden rounded-2xl border" style="border-color: var(--border-color); background: var(--surface-white);" data-reveal data-reveal-type="fade-up">
  <div class="relative aspect-[4/3] overflow-hidden" style="background: var(--surface-warm);">
    <Image
      src={project.image}
      alt={`Screenshot of the ${project.name} website`}
      width={900}
      height={675}
      loading={priority ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
    <span class="absolute left-4 top-4 rounded-full px-3 py-1 font-mono text-[11px]" style="background: var(--surface-white); color: var(--text-primary);">
      {String(index).padStart(2, '0')}
    </span>
    <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wide" style="background: var(--surface-white); color: var(--text-secondary);">
      <span class="h-1.5 w-1.5 rounded-full" style="background: var(--color-success);"></span>
      Client Project
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <span class="eyebrow">{project.category}</span>
    <h3 class="text-xl" style="color: var(--text-primary);">{project.name}</h3>
    <p class="text-sm leading-relaxed" style="color: var(--text-secondary); max-width: none;">{project.results}</p>

    <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
      {project.technologies.map((tech) => (
        <li class="rounded-full px-2.5 py-1 font-mono text-[10px] font-medium" style="background: var(--surface-warm); border: 1px solid var(--border-color); color: var(--text-secondary);">
          {tech}
        </li>
      ))}
    </ul>

    <div class="mt-auto flex flex-wrap gap-3 pt-4">
      <button
        type="button"
        data-view-details
        data-project-slug={project.slug}
        class="view-details-btn inline-flex min-h-[44px] items-center justify-center rounded-full border-2 px-5 text-sm font-bold transition-colors duration-300"
        style="border-color: var(--brand-primary); color: var(--brand-primary);"
      >
        View Details
      </button>
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full px-5 text-sm font-bold transition-colors duration-300"
        style="background: var(--brand-primary); color: var(--text-on-dark);"
      >
        Visit Website
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
      </a>
    </div>
  </div>

  <template data-project-template={project.slug}>
    <div class="flex flex-col gap-6">
      <div class="relative aspect-[16/9] overflow-hidden rounded-2xl" style="background: var(--surface-warm);">
        <Image
          src={project.image}
          alt={`Screenshot of the ${project.name} website`}
          width={1200}
          height={675}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="flex flex-col gap-2">
        <span class="eyebrow">{project.category}</span>
        <h3 class="text-3xl" style="color: var(--text-primary);">{project.name}</h3>
        <p class="leading-relaxed" style="color: var(--text-secondary);">{project.description}</p>
      </div>

      <dl class="grid grid-cols-1 gap-5 border-t pt-6 hairline sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <dt class="eyebrow" style="color: var(--text-secondary);">Role</dt>
          <dd class="text-sm" style="color: var(--text-primary);">{project.role}</dd>
        </div>
        <div class="flex flex-col gap-1.5">
          <dt class="eyebrow" style="color: var(--text-secondary);">Challenge</dt>
          <dd class="text-sm" style="color: var(--text-primary);">{project.goal}</dd>
        </div>
        <div class="flex flex-col gap-1.5">
          <dt class="eyebrow" style="color: var(--text-secondary);">Solution</dt>
          <dd class="text-sm" style="color: var(--text-primary);">{project.contribution}</dd>
        </div>
        <div class="flex flex-col gap-1.5">
          <dt class="eyebrow" style="color: var(--text-secondary);">Results</dt>
          <dd class="text-sm" style="color: var(--text-primary);">{project.results}</dd>
        </div>
      </dl>

      <div class="flex flex-wrap gap-2">
        {project.technologies.map((tech) => (
          <span class="rounded-full px-3 py-1 text-xs font-medium" style="background: var(--surface-warm); border: 1px solid var(--border-color); color: var(--text-primary);">
            {tech}
          </span>
        ))}
      </div>

      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-fit min-h-[48px] items-center justify-center gap-1.5 rounded-full px-6 text-[0.9375rem] font-bold transition-colors duration-300"
        style="background: var(--brand-primary); color: var(--text-on-dark);"
      >
        Visit Website
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
      </a>
    </div>
  </template>
</article>

<style>
  .project-card {
    box-shadow: var(--shadow-sm);
  }
  .project-card:hover {
    box-shadow: 0 20px 40px -20px rgba(37, 19, 79, 0.25);
    border-color: var(--border-strong);
    transform: translateY(-4px);
  }
  .project-card {
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .view-details-btn:hover {
    background: var(--brand-primary);
    color: var(--text-on-dark);
  }
</style>
