---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';

const pageTitle = `Services — ${siteConfig.name}`;
const pageDescription =
  'Two ways I can help: custom WordPress website development, or custom web apps and browser-based tools built with modern, framework-light JavaScript.';
const canonical = `${siteConfig.url}/services`;

const serviceLines = [
  {
    title: 'Website Development (WordPress)',
    description:
      'Custom-built WordPress sites — from brochure sites to e-commerce stores — using Elementor Pro, custom post types, and clean, maintainable code.',
    href: '/services/website-wordpress',
    icon: '<path d="M4 5h16v11H4z"/><path d="M2 20h20"/><path d="M9 20l1-4h4l1 4"/>',
  },
  {
    title: 'Custom Web Apps',
    description:
      'Framework-light, performance-first web apps and browser-based tools — the same approach behind the free Image to WebP Converter on this site.',
    href: '/services/custom-web-apps',
    icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20" style="background: var(--surface-warm);">
    <Container>
      <SectionHeading
        as="h1"
        eyebrow="Services"
        title="What I can build for you"
        description="Whatever stage your website or web app is at, here's how I can help you move it forward."
      />
    </Container>
  </section>

  <section class="pb-24 sm:pb-32" style="background: var(--surface-white);">
    <Container>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {serviceLines.map((line) => (
          <a
            href={line.href}
            class="group flex flex-col gap-5 rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1 sm:p-10"
            style="border-color: var(--border-color); background: var(--surface-warm);"
            data-reveal
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full" style="background: var(--brand-lavender); color: var(--brand-primary);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={line.icon} />
            </span>
            <div class="flex flex-col gap-3">
              <h2 class="text-2xl sm:text-3xl">{line.title}</h2>
              <p class="leading-relaxed" style="color: var(--text-secondary)">{line.description}</p>
            </div>
            <span class="mt-auto flex items-center gap-1.5 text-sm font-bold" style="color: var(--brand-primary);">
              View details
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-all duration-300 group-hover:translate-x-1"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-20 sm:py-24" style="background: var(--brand-dark);">
    <Container class="flex flex-col items-start gap-6">
      <SectionHeading
        eyebrow="Not sure which one you need?"
        title="Let's talk about your project"
        description="Tell me what you're building and I'll point you in the right direction — no pressure, no obligation."
        dark
      />
      <Button href="/contact" variant="primary">Start a Conversation</Button>
    </Container>
  </section>
</BaseLayout>
