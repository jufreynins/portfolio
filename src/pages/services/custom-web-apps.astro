---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';

const pageTitle = `Custom Web Apps — ${siteConfig.name}`;
const pageDescription =
  'Custom web apps and browser-based tools built with modern, framework-light JavaScript and TypeScript — fast, focused, and free of unnecessary bloat.';
const canonical = `${siteConfig.url}/services/custom-web-apps`;

const capabilities = [
  {
    title: 'Browser-based tools & utilities',
    description:
      'Self-contained tools that run entirely client-side — no server, no accounts, no data leaving the browser. The Image to WebP Converter on this site is a live, working example, not a mockup.',
  },
  {
    title: 'Internal tools & dashboards',
    description:
      'Small, focused interfaces for internal use — admin panels, data views, or workflow tools tailored to how your team actually works, without the overhead of a full application framework.',
  },
  {
    title: 'Performance-first frontends',
    description:
      'Built with modern, lightweight tooling (Astro, TypeScript, vanilla JavaScript) instead of defaulting to a heavy framework — smaller bundles, faster loads, and fewer moving parts to maintain.',
  },
  {
    title: 'API & third-party integrations',
    description:
      'Connecting your site or app to the services it needs to talk to — payment processors, CRMs, automation platforms, or your own backend APIs.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20" style="background: var(--surface-warm);">
    <Container class="flex flex-col gap-8">
      <a
        href="/services"
        class="inline-flex w-fit items-center gap-2 text-sm font-medium transition-colors hover:text-zinc-900"
        style="color: var(--text-secondary);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Services
      </a>
      <SectionHeading
        as="h1"
        eyebrow="Custom Web Apps"
        title="When your project needs more than WordPress"
        description="Some ideas don't fit a page builder — a browser-based tool, an internal dashboard, an automation script. I build those with modern, framework-light JavaScript and TypeScript, keeping things fast and free of unnecessary dependencies."
      />
    </Container>
  </section>

  <section class="py-20 sm:py-28" style="background: var(--surface-white);">
    <Container class="flex flex-col gap-14">
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
        {capabilities.map((capability) => (
          <div class="flex flex-col gap-3" data-reveal>
            <h2 class="text-xl font-bold" style="color: var(--text-primary); font-family: var(--font-heading);">{capability.title}</h2>
            <p class="leading-relaxed" style="color: var(--text-secondary)">{capability.description}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-4 rounded-2xl border p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10" style="border-color: var(--border-color); background: var(--brand-soft);" data-reveal>
        <div class="flex flex-col gap-2">
          <span class="eyebrow">Live example</span>
          <h3 class="text-2xl">Image to WebP Converter</h3>
          <p class="max-w-lg leading-relaxed" style="color: var(--text-secondary)">
            A free, browser-based image converter I built and shipped on this site — no uploads, no backend, no account required. It's a real working example of exactly this kind of tool.
          </p>
        </div>
        <Button href="/tools/image-to-webp" variant="secondary" class="w-fit flex-shrink-0">Try the Tool</Button>
      </div>
    </Container>
  </section>

  <section class="py-20 sm:py-24" style="background: var(--brand-dark);">
    <Container class="flex flex-col items-start gap-6">
      <SectionHeading
        eyebrow="Have an idea?"
        title="Let's talk about your project"
        description="Tell me what you're trying to build. If it's a good fit, I'll tell you honestly — no pressure, no obligation."
        dark
      />
      <Button href="/contact" variant="primary">Start a Conversation</Button>
    </Container>
  </section>
</BaseLayout>
