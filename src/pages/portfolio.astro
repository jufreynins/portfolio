---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';

const pageTitle = `WordPress Portfolio — ${siteConfig.name}`;
const pageDescription =
  'Real WordPress websites built for businesses, agencies, and nonprofits — from marketing agencies to e-commerce and community organizations.';
const canonical = `${siteConfig.url}/portfolio`;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="pt-28 pb-12 sm:pt-32 sm:pb-14" style="background: var(--surface-warm);">
    <Container class="flex flex-col gap-4">
      <SectionHeading
        as="h1"
        eyebrow="Portfolio"
        title="Selected WordPress projects."
        description="Real client work — the business need, my contribution, and the WordPress technology behind each site."
      />
      <p class="text-sm" style="color: var(--text-secondary)">
        Every project below is completed client work. Looking for personal projects instead? See
        <a href="/personal-projects" class="font-medium underline" style="color: var(--brand-primary);">Personal Projects</a>.
      </p>
    </Container>
  </section>

  <section class="pb-16 sm:pb-20" style="background: var(--surface-white);">
    <Container>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, i) => (
          <ProjectCard project={project} index={i + 1} priority={i < 3} />
        ))}
      </div>
    </Container>
    <ProjectModal />
  </section>

  <!-- Personal Projects (after client work, visually distinct) -->
  <section class="border-t py-14 sm:py-16" style="border-color: var(--border-color); background: var(--surface-warm);">
    <Container class="flex flex-col gap-8">
      <SectionHeading
        eyebrow="Also Explore"
        title="Personal Projects"
        description="Personal system concepts and browser-based tools — separate from the client work above."
      />
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <a href="/personal-projects" class="lab-card flex flex-col gap-4 rounded-2xl border p-6" style="border-color: var(--border-color); background: var(--surface-white); box-shadow: var(--shadow-sm);" data-reveal>
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-full" style="background: var(--brand-lavender); color: var(--brand-primary);">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wide" style="border-color: var(--border-color); color: var(--text-secondary);">Personal Concept</span>
          </div>
          <h3 class="text-lg font-bold" style="color: var(--text-primary); font-family: var(--font-heading);">Personal Projects</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">Web system concepts for task management, inventory, and internal operations.</p>
        </a>
        <a href="/tools" class="lab-card flex flex-col gap-4 rounded-2xl border p-6" style="border-color: var(--border-color); background: var(--surface-white); box-shadow: var(--shadow-sm);" data-reveal>
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-full" style="background: var(--brand-lavender); color: var(--brand-primary);">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a2 2 0 0 0 3 3l6-6a4 4 0 0 0 5.4-5.4l-3 3-2-2 3-3Z"/></svg>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wide" style="border-color: color-mix(in srgb, var(--color-success) 35%, white); color: var(--color-success); background: var(--color-success-soft);">Free Tool</span>
          </div>
          <h3 class="text-lg font-bold" style="color: var(--text-primary); font-family: var(--font-heading);">Tools</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">Small privacy-focused utilities such as image conversion, with more planned.</p>
        </a>
      </div>
    </Container>
  </section>

  <section class="dark-grid-bg py-16 sm:py-20" style="background: var(--brand-dark);">
    <Container class="flex flex-col items-start gap-6">
      <SectionHeading
        eyebrow="Let's build something"
        title="Ready to start a project?"
        description="Tell me a bit about what you're building. I typically reply within one business day."
        dark
      />
      <Button href="/contact" variant="primary">Discuss Your Website</Button>
    </Container>
  </section>
</BaseLayout>

<style>
  .lab-card {
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .lab-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
</style>
