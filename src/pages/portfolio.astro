---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';

const pageTitle = `Portfolio — ${siteConfig.name}`;
const pageDescription =
  'Real WordPress websites built for businesses, agencies, and nonprofits — from marketing agencies to e-commerce and community organizations.';
const canonical = `${siteConfig.url}/portfolio`;

const [firstProject, secondProject, thirdProject, ...remainingProjects] = projects;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20" style="background: var(--surface-warm);">
    <Container class="flex flex-col gap-4">
      <SectionHeading
        as="h1"
        eyebrow="Portfolio"
        title="Selected Websites, Web Systems, and Digital Tools"
        description="Real businesses, real websites — a closer look at the kind of work I bring to every project."
        watermark="WORK"
      />
      <p class="text-sm" style="color: var(--text-secondary)">
        The websites below are completed client work. Looking for something else? See
        <a href="/systems" class="font-medium underline" style="color: var(--brand-primary);">Web Systems</a>
        or <a href="/tools" class="font-medium underline" style="color: var(--brand-primary);">Web Tools</a>.
      </p>
    </Container>
  </section>

  <section class="pb-24 sm:pb-32" style="background: var(--surface-white);">
    <Container class="flex flex-col gap-20 sm:gap-24">
      <div class="flex flex-col gap-20 sm:gap-24">
        <ProjectFeature project={firstProject} layout="full" index={1} />
        <ProjectFeature project={secondProject} layout="left" index={2} />
        <ProjectFeature project={thirdProject} layout="right" index={3} />
      </div>

      {remainingProjects.length > 0 && (
        <div class="grid grid-cols-1 gap-8 border-t pt-16 sm:grid-cols-2 lg:grid-cols-3" style="border-color: var(--border-color);">
          {remainingProjects.map((project, i) => (
            <ProjectCard project={project} index={i + 4} />
          ))}
        </div>
      )}
    </Container>
    <ProjectModal />
  </section>

  <section class="dark-grid-bg py-20 sm:py-24" style="background: var(--brand-dark);">
    <Container class="flex flex-col items-start gap-6">
      <SectionHeading
        eyebrow="Let's build something"
        title="Ready to start a project?"
        description="Tell me a bit about what you're building. I typically reply within one business day."
        dark
      />
      <Button href="/contact" variant="primary">Start a Conversation</Button>
    </Container>
  </section>
</BaseLayout>
