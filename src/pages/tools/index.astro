---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';

const pageTitle = `Free Web Tools — ${siteConfig.name}`;
const pageDescription =
  'Free, browser-based web tools built by Jufrey Niño Bayog. No uploads, no accounts, no tracking — files are processed locally in your browser whenever possible.';
const canonical = `${siteConfig.url}/tools`;

const featuredTool = {
  title: 'Image to WebP Converter',
  category: 'Image Tools',
  description:
    'Convert JPG and PNG images to lightweight WebP files directly in your browser — batch convert, compare file size savings, and download individually or as a ZIP.',
  formats: 'JPG, JPEG, PNG',
  processing: 'Local browser processing (Canvas API)',
  privacy: 'No uploads, no storage, no account required',
  href: '/tools/image-to-webp',
};

interface ToolConcept {
  title: string;
  category: 'Images' | 'SEO' | 'Development' | 'Productivity';
  status: 'In Development' | 'Planned';
  description: string;
  icon: string;
}

const toolConcepts: ToolConcept[] = [
  {
    title: 'Image Compressor',
    category: 'Images',
    status: 'Planned',
    description: 'Reduce image file size while preserving visual quality, without converting format.',
    icon: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V4s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>',
  },
  {
    title: 'SEO Meta Preview',
    category: 'SEO',
    status: 'Planned',
    description: 'Preview how a page title and meta description will appear in search results.',
    icon: '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  },
  {
    title: 'Open Graph Preview',
    category: 'SEO',
    status: 'Planned',
    description: 'Check how a page will look when shared on social platforms before publishing.',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  },
  {
    title: 'Favicon Generator',
    category: 'Development',
    status: 'Planned',
    description: 'Generate a full favicon set from a single source image.',
    icon: '<rect x="4" y="4" width="16" height="16" rx="4"/>',
  },
  {
    title: 'UTM Builder',
    category: 'Productivity',
    status: 'Planned',
    description: 'Build consistent, trackable campaign links without guessing parameter names.',
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
  {
    title: 'Text Case Converter',
    category: 'Productivity',
    status: 'Planned',
    description: 'Convert text between sentence case, title case, upper case, and slug format.',
    icon: '<polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/>',
  },
  {
    title: 'JSON Formatter',
    category: 'Development',
    status: 'Planned',
    description: 'Format, validate, and minify JSON directly in the browser.',
    icon: '<path d="M4 7V5a2 2 0 0 1 2-2h2M4 17v2a2 2 0 0 0 2 2h2M20 7V5a2 2 0 0 0-2-2h-2M20 17v2a2 2 0 0 1-2 2h-2"/>',
  },
  {
    title: 'Website Screenshot Tool',
    category: 'Development',
    status: 'Planned',
    description: 'Capture a full-page screenshot of any public URL for quick review or sharing.',
    icon: '<rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  },
];

const statusStyles: Record<string, string> = {
  'In Development': 'color: var(--color-warning); border-color: color-mix(in srgb, var(--color-warning) 35%, white); background: var(--color-warning-soft);',
  Planned: 'color: var(--text-muted); border-color: var(--border-color); background: var(--surface-white);',
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20" style="background: var(--surface-warm);">
    <Container class="flex flex-col gap-6">
      <SectionHeading
        as="h1"
        eyebrow="Free Tools"
        title="Practical tools built for faster digital work"
        description="A small, growing collection of browser-based tools for developers, marketers, and business owners — no uploads, no accounts, no tracking."
      />
      <p class="flex items-center gap-2 text-sm font-medium" style="color: var(--text-secondary);">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-primary);"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4Z"/></svg>
        Files are processed locally in your browser whenever possible.
      </p>
    </Container>
  </section>

  <!-- Featured tool -->
  <section class="py-16 sm:py-20" style="background: var(--surface-white);">
    <Container>
      <div class="grid grid-cols-1 gap-10 rounded-2xl border p-8 sm:p-12 lg:grid-cols-12 lg:gap-12" style="border-color: var(--border-strong); background: var(--brand-soft); box-shadow: var(--shadow-brand);" data-reveal>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <span class="eyebrow">Featured &bull; Live Tool</span>
          <h2 class="text-3xl sm:text-4xl">{featuredTool.title}</h2>
          <p class="max-w-xl leading-relaxed" style="color: var(--text-secondary);">{featuredTool.description}</p>

          <dl class="grid grid-cols-1 gap-4 border-t pt-5 sm:grid-cols-2" style="border-color: var(--border-color);">
            <div class="flex flex-col gap-1">
              <dt class="text-xs font-bold uppercase tracking-wide" style="color: var(--text-secondary);">Accepted Formats</dt>
              <dd class="text-sm" style="color: var(--text-primary);">{featuredTool.formats}</dd>
            </div>
            <div class="flex flex-col gap-1">
              <dt class="text-xs font-bold uppercase tracking-wide" style="color: var(--text-secondary);">Processing</dt>
              <dd class="text-sm" style="color: var(--text-primary);">{featuredTool.processing}</dd>
            </div>
            <div class="flex flex-col gap-1 sm:col-span-2">
              <dt class="text-xs font-bold uppercase tracking-wide" style="color: var(--text-secondary);">Privacy</dt>
              <dd class="text-sm" style="color: var(--text-primary);">{featuredTool.privacy}</dd>
            </div>
          </dl>

          <div class="pt-2">
            <Button href={featuredTool.href} variant="primary">Open Tool</Button>
          </div>
        </div>

        <div class="flex items-center justify-center lg:col-span-5">
          <div class="flex w-full flex-col gap-3 rounded-2xl border p-6" style="border-color: var(--border-color); background: var(--surface-white);">
            <div class="flex items-center justify-between text-xs font-mono" style="color: var(--text-muted);">
              <span>photo.jpg &bull; 4.2 MB</span>
              <span style="color: var(--brand-primary);">80% quality</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg" style="background: var(--brand-lavender);">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-primary);"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted);"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg" style="background: var(--color-success-soft);">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-success);"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="flex items-center justify-between text-xs font-mono" style="color: var(--text-muted);">
              <span>photo.webp &bull; 640 KB</span>
              <span style="color: var(--color-success);">−85%</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- More tools -->
  <section class="py-16 sm:py-20" style="background: var(--surface-warm);">
    <Container class="flex flex-col gap-10">
      <SectionHeading
        eyebrow="Coming Soon"
        title="More tools in progress"
        description="Concepts I'm planning to build next. These are not live yet — each is clearly labeled so you know exactly what's available today."
      />
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {toolConcepts.map((tool) => (
          <div
            class="flex flex-col gap-3 rounded-2xl border p-5 opacity-80"
            style="border-color: var(--border-color); background: var(--surface-white);"
            data-reveal
          >
            <div class="flex items-start justify-between gap-2">
              <span class="flex h-10 w-10 items-center justify-center rounded-full" style="background: var(--surface-warm); color: var(--text-muted);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
              </span>
              <span
                class="inline-flex flex-shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wide"
                style={statusStyles[tool.status]}
              >
                {tool.status}
              </span>
            </div>
            <span class="eyebrow" style="color: var(--text-muted);">{tool.category}</span>
            <h3 class="text-base font-bold" style="color: var(--text-primary); font-family: var(--font-heading);">{tool.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">{tool.description}</p>
          </div>
        ))}
      </div>
      <p class="text-sm" style="color: var(--text-muted);">
        Have a tool idea that would help your workflow? <a href="/contact" class="font-medium underline" style="color: var(--brand-primary);">Let me know</a>.
      </p>
    </Container>
  </section>
</BaseLayout>
